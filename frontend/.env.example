# Copy to `.env.local` (gitignored). Vite only reads this directory.

# Default is local Mix: http://127.0.0.1:4001
# Point at Fly to develop the SPA against production data. Do not run Mix.
# Writes from this Vite session go to the remote database.
# Staging later is the same variable with a different URL.
# VITE_API_URL=https://flambe.fly.dev
