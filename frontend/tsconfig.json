{
  "compilerOptions": {
    "allowJs": false,
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2022"
  },
  "include": ["packages/core/src/**/*.ts", "packages/core/src/**/*.tsx"]
}
