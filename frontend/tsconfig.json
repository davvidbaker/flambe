{
  "compilerOptions": {
    "allowJs": false,
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "types": ["node", "vitest/globals"],
    "paths": {
      "@davvidbaker/flame-chart": ["./packages/flame-chart/src/index.ts"],
      "@davvidbaker/flame-chart/flambe": ["./packages/flame-chart/src/flambe.ts"]
    }
  },
  "include": [
    "packages/core/src/**/*.ts",
    "packages/core/src/**/*.tsx",
    "packages/flame-chart/src/**/*.ts",
    "packages/flame-chart/src/**/*.tsx",
    "playwright/**/*.ts",
    "playwright.config.ts",
    "vitest.config.mts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ]
}
