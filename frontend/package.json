{
  "name": "flambe",
  "private": true,
  "workspaces": [
    "packages/core"
  ],
  "version": "0.0.0",
  "description": "Flambe timeline application",
  "scripts": {
    "dev": "vite --config vite.config.mjs",
    "dev:share-viewer": "vite --config packages/share-viewer/vite.config.ts",
    "build": "vite build --config vite.config.mjs",
    "build:share-viewer": "vite build --config packages/share-viewer/vite.config.ts",
    "preview": "vite preview --config vite.config.mjs",
    "test": "npm run test:smoke",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:smoke": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davvidbaker/flame-chart.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/davvidbaker/flame-chart/issues"
  },
  "homepage": "https://github.com/davvidbaker/flame-chart#readme",
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@playwright/test": "^1.62.1",
    "@types/fuzzaldrin-plus": "^0.6.5",
    "@types/humanize-duration": "^3.27.4",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.2.0",
    "@types/phoenix": "^1.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-modal": "^3.16.3",
    "@types/tinycolor2": "^1.4.6",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redux": "^5.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "@storybook/react-vite": "^10.3.6",
    "storybook": "^10.3.6"
  }
}
