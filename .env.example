FLAMBE_URL=http://127.0.0.1:4001
# After `flambe serve`, use the printed token and URL (loopback SQLite).
# For the Fly instance instead:
# FLAMBE_URL=https://your-app.fly.dev
# Cursor Cloud: set these as environment secrets instead of committing .env.
FLAMBE_API_TOKEN=flb_replace_me
FLAMBE_TRACE_ID=1
# Optional: pin `flambe start` to a thread when --thread is omitted.
# Name, unique slug, or id. `flambe` matches `flambé🔥`.
# FLAMBE_THREAD=flambe

# Public timeline shares (frozen snapshots). Viewer is a separate Vercel app.
# FLAMBE_SHARE_VIEWER_URL=https://your-share-viewer.vercel.app
# VERCEL_BLOB_READ_WRITE_TOKEN=
