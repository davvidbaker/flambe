    "url": "git+https://github.com/davvidbaker/flambe.git",
    "directory": "single-burner"
  },
  "homepage": "https://github.com/davvidbaker/flambe/tree/main/single-burner",
  "bugs": {
    "url": "https://github.com/davvidbaker/flambe/issues"
  },
  "publishConfig": {
