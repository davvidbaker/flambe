{
  "name": "@davvidbaker/flambe-single-burner",
  "version": "0.1.0",
  "description": "Self-contained local Flambé with SQLite and a bundled UI",
  "type": "module",
  "bin": {
    "flambe-single-burner": "./bin/flambe-single-burner.mjs"
  },
  "files": [
